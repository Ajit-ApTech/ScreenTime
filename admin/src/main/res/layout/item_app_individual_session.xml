<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <!-- Colored session dot -->
    <View
        android:id="@+id/viewSessionDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_pill_green" />

    <!-- Time range text -->
    <TextView
        android:id="@+id/tvSessionTimeRange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:text="09:15 AM – 09:42 AM"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- Duration badge -->
    <TextView
        android:id="@+id/tvSessionDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_indigo"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="27m"
        android:textColor="@color/chip_indigo_text"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
